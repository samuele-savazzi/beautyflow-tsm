{
  "$schema": "node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.2.0",
    "generators": {
      "dart-dio": {
        "generatorName": "dart-dio",
        "output": "lib/api/generated",
        "glob": "openapi.yaml",
        "additionalProperties": {
          "pubName": "beautyflow_api",
          "pubVersion": "1.0.0",
          "pubDescription": "BeautyFlow API Client",
          "pubAuthor": "BeautyFlow Team",
          "dateLibrary": "core",
          "nullableFields": true,
          "useEnumExtension": true
        }
      }
    }
  }
}
